---
import store from "@store";
import Layout from "@layouts/Layout.astro";
import { pluralize } from "@util/string";
import { getArtistDisplayName, getReleaseUrl } from "@util/data";
import { getLogUrl, getMonthName } from "@util/log";

const log = store.log;
---

<Layout title="Log">
  <main class="standard-restricted-width">
    <h1 class="standard-page-title">Log</h1>
    <p class="intro">
      Records I've added each month, starting in January 2025. Before that I
      wasn't tracking when I got things.
    </p>

    {
      log.map((month) => (
        <section>
          <h2>
            <a href={getLogUrl(month.key)}>{getMonthName(month.key)}</a>
            <span class="count">
              {month.releases.length}{" "}
              {pluralize("record", month.releases.length)}
            </span>
          </h2>
          {month.releases.length ? (
            <ul>
              {month.releases.map((release) => (
                <li>
                  <a href={getReleaseUrl(release)}>
                    {getArtistDisplayName(
                      release.basic_information.artists[0].name
                    )}{" "}
                    – {release.basic_information.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Nothing added.</p>
          )}
        </section>
      ))
    }
  </main>
</Layout>

<style>
  .intro {
    font-size: var(--font-size-20);
    margin: 0 0 var(--sp-24);
    max-width: 50ch;
  }

  section {
    padding-top: var(--sp-24);
  }

  h2 {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-10);
    font-size: var(--font-size-32);
    font-style: italic;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 var(--sp-12);
  }

  .count {
    color: var(--color-accent-primary);
    font-size: var(--font-size-16);
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: var(--sp-10);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:where(:hover, :focus) {
    color: var(--color-accent-primary);
  }

  .empty {
    margin: 0;
    opacity: 0.8;
  }
</style>
