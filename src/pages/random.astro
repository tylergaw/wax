---
import store from "@store";
import { getReleaseUrl } from "@util/data";

export const prerender = false;

// Pick any release from the collection and send the visitor to its page.
// This is a server-side 302 so the browser lands on a real, shareable URL.
// It's temporary and not cacheable so every visit gets a new release.
const { collection } = store;
const release = collection[Math.floor(Math.random() * collection.length)];

return new Response(null, {
  status: 302,
  headers: {
    Location: getReleaseUrl(release),
    "Cache-Control": "no-store",
  },
});
---
