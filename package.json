{
  "name": "wax",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "pipeline:fetch": "cd pipeline && node --env-file .env ./src/getCollection.js",
    "pipeline:fetch:skipPrompt": "cd pipeline && node --env-file .env ./src/getCollection.js --skipPagePrompt",
    "pipeline:masters": "cd pipeline && node --env-file .env ./src/getMasters.js",
    "pipeline:covers": "cd pipeline && node --env-file .env ./src/getCovers.js",
    "pipeline:enrich": "cd pipeline && node --env-file .env ./src/enrichCollection.js",
    "pipeline:update": "npm run pipeline:fetch:skipPrompt && npm run pipeline:masters && npm run pipeline:covers && npm run pipeline:enrich",
    "pipeline:test": "cd pipeline && TEST=true node --env-file .env --test"
  },
  "engines": {
    "node": ">= 20.6.1"
  },
  "dependencies": {
    "@astrojs/netlify": "5.5.1",
    "astro": "4.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@aws-sdk/client-s3": "3.700.0",
    "@types/lodash": "4.14.195",
    "@types/slug": "5.0.3",
    "@vitest/ui": "2.0.5",
    "lodash": "4.17.21",
    "prettier": "2.8.8",
    "prettier-plugin-astro": "0.10.0",
    "sharp": "0.33.5",
    "slug": "8.2.2",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
