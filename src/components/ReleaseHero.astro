---
export interface props {
  artist: string;
  release: Release;
}

import type { Release } from "@types";
import Vinyl from "@components/Vinyl.astro";
import {
  buildUrl,
  getCoverUrl,
  getHumanColor,
  getMachineColor,
  getArtistDisplayName,
  getDiscCount,
  getFormatLabel,
} from "@util/data";
import { getReleaseDateParts } from "@util/log";

const { artist, release } = Astro.props;
const { title } = release.basic_information;
const coverUrl = getCoverUrl(release, 1200);
const format = getFormatLabel(release);
const discOffsets = Array.from(
  { length: Math.min(getDiscCount(release), 6) },
  (_, i) => Math.ceil(i / 2) * (i % 2 ? 1 : -1)
).sort((a, b) => Math.abs(b) - Math.abs(a));
const dateParts = getReleaseDateParts(release);
---

<div class="container" style={`--machine-color: ${getMachineColor(release)}`}>
  <header>
    <h1 class="title">{title}</h1>
    <p class="subtitle">
      <a href={buildUrl([artist])}>{getArtistDisplayName(artist)}</a> /{" "}
      {format && `${format} / `}
      {getHumanColor(release)}
    </p>
    {
      dateParts.length > 0 && (
        <p class="dates">
          {dateParts.map((part, i) => (
            <>
              {i > 0 && ", "}
              {part.href ? <a href={part.href}>{part.text}</a> : part.text}
            </>
          ))}
        </p>
      )
    }
  </header>
  <div class="graphic">
    {
      discOffsets.map((offset) => (
        <div
          class="disc"
          style={`translate: ${offset * 9}% 0; filter: brightness(${
            1 - Math.abs(offset) * 0.12
          })`}
        >
          <Vinyl class="vinyl" color={getMachineColor(release)} />
        </div>
      ))
    }
    {
      coverUrl && (
        <div class="cover">
          <img src={coverUrl} alt="" width="500" height="500" />
        </div>
      )
    }
  </div>
</div>

<style>
  header {
    padding-bottom: calc(var(--sp-8) * 4);
    padding-top: calc(var(--sp-8) * 2);
    text-align: center;
  }

  .title {
    font-style: italic;
    font-size: 72px;
    font-weight: 900;
    line-height: 1;
    margin: 0;
  }

  .subtitle {
    color: var(--color-accent-primary);
    font-size: var(--font-size-22);
    font-weight: 300;
    margin: 0 auto;
    max-width: 800px;
    padding-top: var(--sp-14);
  }

  .dates {
    font-size: var(--font-size-16);
    font-weight: 300;
    margin: 0;
    padding-top: var(--sp-4);
  }

  :is(.subtitle, .dates) a {
    color: inherit;
  }

  .dates a:where(:hover, :focus) {
    color: var(--color-accent-primary);
  }

  .graphic {
    display: grid;
    overflow-x: clip;
    grid-template: "container";
    place-items: center;
    padding-bottom: var(--sp-20);
  }

  .cover,
  .disc {
    grid-area: container;
  }

  .cover {
    background: var(--machine-color);
    border: 1px solid currentColor;
    max-width: 500px;
    position: relative;
    width: 80%;
  }

  img {
    display: block;
    height: auto;
    width: 100%;
  }

  .disc {
    max-width: 680px;
    overflow: hidden;
    width: 100%;
  }

  .vinyl {
    animation: spin 1.5s linear infinite;
    display: block;
    pointer-events: none;
  }
</style>
