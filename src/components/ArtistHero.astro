---
import type { Artist, Release } from "@types";
import { getArtistDisplayName, getCoverUrl } from "@util/data";
import { getVinylLook } from "@util/vinylLook";
import Vinyl from "@components/Vinyl.astro";

export interface Props {
  artist: Artist;
  releases: Release[];
}

const { artist, releases } = Astro.props;
const seed = Number(artist.id) || 1;

const random = (() => {
  let s = seed;
  return () => {
    s |= 0;
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
})();
const between = (min: number, max: number) => min + random() * (max - min);
const chance = (odds: number) => random() < odds;
const pick = <T,>(list: T[]): T => list[Math.floor(random() * list.length)];
const shuffle = <T,>(list: T[]): T[] =>
  list
    .map((item) => ({ item, sort: random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ item }) => item);

const withCovers = [
  ...new Map(
    releases.flatMap((release) => {
      const src = getCoverUrl(release, 600);
      return src ? [[src, { src, release }] as const] : [];
    })
  ).values(),
];

const palette = [
  ...new Set(
    releases.flatMap((release) => {
      const look = getVinylLook(release);
      return [look.base, ...look.accents];
    })
  ),
].filter((color) => !color.startsWith("var(") && !/^(white|black)$/.test(color));
const colors = palette.length ? palette : ["#0000ee", "#ff5a36", "#ffd400"];

// Cycle through the covers so small discographies still fill the space
const deal = (count: number) => {
  let order: typeof withCovers = [];
  while (order.length < count) order = order.concat(shuffle(withCovers));
  return order.slice(0, count);
};

// A rough bottom edge, like paper torn off a page
const tornEdge = () => {
  const steps = 14;
  const points = Array.from({ length: steps + 1 }, (_, i) => {
    const x = 100 - (i / steps) * 100;
    return `${x.toFixed(1)}% ${between(91, 99).toFixed(1)}%`;
  });
  return `polygon(0 0, 100% 0, ${points.join(", ")})`;
};

// The back layer takes spots on a jittered grid so pieces spread out, then
// smaller pieces scatter on top. Artists with more records get more pieces.
const columns = 8;
const rows = 4;
const clamp = (n: number, min: number, max: number) =>
  Math.round(Math.min(max, Math.max(min, n)));
const count = releases.length;
const cells = shuffle(Array.from({ length: columns * rows }, (_, i) => i));
const back = deal(clamp(count * 2 + 10, 12, 30)).map((item, i) => ({
  ...item,
  x: ((cells[i] % columns) + 0.5 + between(-0.55, 0.55)) / columns,
  y: (Math.floor(cells[i] / columns) + 0.5 + between(-0.55, 0.55)) / rows,
  size: chance(0.2) ? between(0.18, 0.26) : between(0.3, 0.5),
  front: false,
}));
const front = deal(clamp(count * 0.6 + 2, 3, 10)).map((item) => ({
  ...item,
  x: between(0, 1),
  y: between(0, 1),
  size: between(0.16, 0.34),
  front: true,
}));

const pieces = [...back, ...front].map((piece) => {
  const style = pick(["sleeve", "sleeve", "sleeve", "print", "torn", "tint", "strip", "round"]);
  const tilt = piece.size < 0.28 && chance(0.4) ? 38 : 20;
  return {
    ...piece,
    style,
    rotate: between(-tilt, tilt),
    crop: `${between(0, 100).toFixed(0)}% ${between(0, 100).toFixed(0)}%`,
    // Discs slide out of sleeves on top, where they won't get covered up
    disc: piece.front && style === "sleeve" && chance(0.6) && pick([[42, 3], [-42, 3], [3, -42]]),
    tape: chance(0.3) && { left: between(5, 60), rotate: between(-25, 25) },
    tint: pick(colors),
    clip: style === "torn" ? tornEdge() : undefined,
  };
});

const dash = () => ({
  x: between(0, 1600),
  y: between(40, 688),
  length: between(14, 56),
  angle: between(0, 180),
  width: between(3, 7),
});

const shape = () => ({
  kind: pick(["ring", "squiggle", "cross", "cross"]),
  x: between(0, 1600),
  y: between(40, 688),
  size: between(24, 70),
  rotate: between(0, 360),
});

const layers = [
  {
    name: "under",
    dashes: Array.from({ length: 12 }, dash),
    shapes: Array.from({ length: 6 }, shape),
  },
  {
    name: "over",
    dashes: Array.from({ length: 40 }, dash),
    shapes: Array.from({ length: 8 }, shape),
  },
];

const id = `hero-${artist.id}`;
const name = getArtistDisplayName(artist.name);

// Paint Factory has no accented letters, so swap them for something better
const nameParts = [...name].map((char) => {
  const marks = char.normalize("NFD").slice(1);
  if (!marks) return { text: char };
  const emoji = marks.includes("\u0308") ? "🤘" : "🧐";
  return { text: `\u2060${emoji}\u2060`, swap: true };
});
// Size the name to fill the width. Paint Factory Bold runs about 0.6em per
// character. Longer names break onto two lines at the most even word break.
const words = name.split(" ");
const longestLine =
  name.length > 14 && words.length > 1
    ? Math.min(
        ...words.slice(1).map((_, i) => {
          const first = words.slice(0, i + 1).join(" ");
          return Math.max(first.length, name.length - first.length - 1);
        })
      )
    : name.length;
const fit = 90 / (0.62 * longestLine);
const maxSize = name.length <= 6 ? 280 : 180;

---

<header
  class="hero"
  style={`--fit: ${fit.toFixed(2)}vw; --max-size: ${maxSize}px`}
>
  <div class="frame">
    {
      layers.map((layer) => (
        <>
          <svg
            class="marks"
            viewBox="0 0 1600 728"
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
          >
            <defs>
              <filter id={`${id}-${layer.name}-rough`}>
                <feTurbulence type="fractalNoise" baseFrequency="0.3" numOctaves="1" seed="3" />
                <feDisplacementMap in="SourceGraphic" scale="3" xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
            <g filter={`url(#${id}-${layer.name}-rough)`} stroke="currentColor" stroke-linecap="round" fill="none">
              {layer.dashes.map((d) => (
                <line
                  x1={-d.length / 2}
                  x2={d.length / 2}
                  stroke-width={d.width}
                  transform={`translate(${d.x} ${d.y}) rotate(${d.angle})`}
                />
              ))}
              {layer.shapes.map((s) => {
                const n = s.size;
                const transform = `translate(${s.x} ${s.y}) rotate(${s.rotate})`;
                if (s.kind === "ring")
                  return <circle r={n / 2} stroke-width="6" transform={transform} />;
                if (s.kind === "cross")
                  return <path d={`M${-n / 2} 0H${n / 2}M0 ${-n / 2}V${n / 2}`} stroke-width="7" transform={transform} />;
                return (
                  <path
                    d={`M${-n} 0q${n / 4} ${-n / 3} ${n / 2} 0t${n / 2} 0t${n / 2} 0t${n / 2} 0`}
                    stroke-width="6"
                    transform={transform}
                  />
                );
              })}
            </g>
          </svg>
          {layer.name === "under" && (
            <div class="pieces" aria-hidden="true">
              {pieces.map((piece) => (
                <div
                  class:list={["piece", piece.style]}
                  style={[
                    `left: ${(piece.x * 100).toFixed(1)}%`,
                    `top: ${(piece.y * 100).toFixed(1)}%`,
                    `--size: ${piece.size.toFixed(3)}`,
                    `--r: ${piece.rotate.toFixed(1)}deg`,
                    `--tint: ${piece.tint}`,
                    `--crop: ${piece.crop}`,
                    piece.clip && `--clip: ${piece.clip}`,
                  ]
                    .filter(Boolean)
                    .join("; ")}
                >
                  {piece.disc && (
                    <Vinyl
                      class="disc"
                      look={getVinylLook(piece.release)}
                      style={`left: ${piece.disc[0]}%; top: ${piece.disc[1]}%`}
                    />
                  )}
                  <img src={piece.src} alt="" />
                  {piece.tape && (
                    <span
                      class="tape"
                      style={`left: ${piece.tape.left.toFixed(0)}%; rotate: ${piece.tape.rotate.toFixed(0)}deg`}
                    />
                  )}
                </div>
              ))}
            </div>
          )}
        </>
      ))
    }
  </div>

  <div class="heading standard-restricted-width">
    <h1 class="title" aria-label={name}>
      {nameParts.map((part) =>
        part.swap ? <span class="swap">{part.text}</span> : part.text
      )}
    </h1>
  </div>
</header>

<style>
  .hero {
    --u: 520px;
    display: grid;
    height: calc(var(--u) * 1.4);
    margin-bottom: var(--sp-16);
    overflow: clip;
    place-items: center;
    position: relative;
  }

  .frame {
    height: 100%;
    left: 50%;
    max-width: 1440px;
    position: absolute;
    top: 0;
    translate: -50% 0;
    width: 100%;
  }

  @media (max-width: 700px) {
    .hero {
      --u: 340px;
    }
  }

  .marks {
    color: var(--color-primary-dark);
    height: 100%;
    inset: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
  }

  .pieces {
    inset: calc(var(--u) * 0.32) 0;
    position: absolute;
  }

  .piece {
    aspect-ratio: 1;
    position: absolute;
    rotate: var(--r);
    translate: -50% -50%;
    width: calc(var(--size) * var(--u));
  }

  .piece img {
    display: block;
    position: relative;
    width: 100%;
  }

  .print img {
    border: calc(var(--u) * 0.016) solid #fbf8f1;
  }

  .strip {
    aspect-ratio: 2.6;
  }

  .strip img {
    height: 100%;
    object-fit: cover;
    object-position: var(--crop);
  }

  .round img {
    border-radius: 50%;
  }

  .torn img {
    clip-path: var(--clip);
  }

  .tint {
    background: var(--tint);
  }

  .tint img {
    filter: grayscale(1) contrast(1.3);
    mix-blend-mode: multiply;
  }

  .disc {
    position: absolute;
    width: 94%;
  }

  .tape {
    background: rgb(255 248 220 / 0.7);
    height: 13%;
    position: absolute;
    top: -5%;
    width: 38%;
  }

  .heading {
    position: relative;
    text-align: center;
    width: 100%;
  }

  .title {
    color: var(--color-background);
    font-family: var(--font-paint);
    font-size: clamp(48px, var(--fit), var(--max-size));
    font-weight: bold;
    line-height: 0.8;
    margin: 0;
    paint-order: stroke fill;
    text-wrap: balance;
    -webkit-text-stroke: 8px var(--color-text);
  }

  .swap {
    -webkit-text-stroke: 0;
  }

  @media (max-width: 700px) {
    .title {
      font-size: clamp(56px, max(var(--fit), 20vw), var(--max-size));
      hyphens: auto;
      overflow-wrap: anywhere;
      text-transform: lowercase;
    }
  }

  @media (max-width: 420px) {
    .title {
      line-height: 1;
    }
  }
</style>
