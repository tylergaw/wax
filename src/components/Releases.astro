---
export interface Props {
  className?: string;
  releases: Release[];
  showArtist?: boolean;
}

import type { Release } from "@types";
import {
  getArtistDisplayName,
  getCoverUrl,
  getDiscCount,
  getFormatLabel,
  getHumanColor,
  getMachineColor,
  getReleaseUrl,
} from "@util/data";
import Vinyl from "@components/Vinyl.astro";

function getRandomNumber() {
  return Math.random() * 2.4 - 1.2;
}

const { className = "standard", releases, showArtist = true } = Astro.props;
const isMini = className === "mini";
---

<ul class={className}>
  {
    releases.map((release: Release) => {
      const {
        basic_information: { title, artists },
      } = release;
      const color = getMachineColor(release);
      const coverUrl = getCoverUrl(release, 600);
      const format = getFormatLabel(release);
      const discCount = Math.min(getDiscCount(release), 3);

      return (
        <li data-id={release.id}>
          <a
            href={getReleaseUrl(release)}
            style={`--machine-color: ${color}; --rotation: ${getRandomNumber()}deg;`}
          >
            {isMini ? (
              <div class="graphic">
                <Vinyl class="vinyl" color={color} />
              </div>
            ) : (
              <div class="graphic" style={`--count: ${discCount}`}>
                {Array.from({ length: discCount }, (_, d) => (
                  <Vinyl class="disc" color={color} style={`--d: ${d}`} />
                ))}
                <div class="cover">
                  {coverUrl && (
                    <img
                      src={coverUrl}
                      alt=""
                      width="600"
                      height="600"
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
            )}
            <div class="info">
              <div class="primary-info">
                <p class="title font-display">{title}</p>
                {showArtist && (
                  <p class="artist">{getArtistDisplayName(artists[0].name)}</p>
                )}
              </div>
              <p class="desciption">
                {format && `${format} / `}
                {getHumanColor(release)}
              </p>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: inherit;
    display: block;
    text-decoration: none;
  }

  a:where(:hover, :focus) .title {
    color: var(--color-accent-primary);
  }

  .graphic {
    overflow: hidden;
    position: relative;
  }

  .info {
    overflow: hidden;
    padding: var(--sp-10);
    padding-bottom: 0;
  }

  .title,
  .artist {
    margin: 0;
  }

  .title {
    font-style: italic;
    font-size: var(--font-size-28);
    font-weight: 900;
    line-height: 1em;
    letter-spacing: -0.03em;
  }

  .artist {
    color: var(--color-accent-primary);
    font-size: var(--font-size-16);
    letter-spacing: 0.05em;
    margin-top: var(--sp-4);
    text-transform: uppercase;
  }

  .desciption {
    font-size: var(--font-size-16);
    font-weight: 100;
    letter-spacing: -0.01em;
    opacity: 0.8;
    margin: var(--sp-20) 0 0 0;
    max-width: 100%;
    overflow: hidden;
    text-transform: capitalize;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  ul.standard {
    --gap: calc(var(--g-gutter) * 4);
    column-gap: var(--gap);
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, max(260px, (100% - var(--gap) * 4) / 5)), 1fr)
    );
  }

  .standard li {
    padding-bottom: calc(var(--sp-10) * 6);
  }

  .standard .graphic {
    --pop: 1.75rem;
    --stack: 30;
    --band: 3.5;
    --shrink: 0.04;
    container-type: inline-size;
    padding-top: 6.25rem;
  }

  .standard .disc {
    --size: calc((1 - var(--d) * var(--shrink)) * 98.25cqw);
    --top: calc((var(--count) - 1 - var(--d)) * var(--band) * 1cqw);
    animation: spin 1s linear infinite paused;
    animation-delay: calc(var(--d) * -0.31s);
    filter: drop-shadow(0 -1px 0 rgb(255 255 255 / 0.35));
    left: 50%;
    position: absolute;
    top: calc(var(--top) + var(--pop));
    transform-origin: 50.5% 50.6%;
    transition: top 0.1s ease;
    translate: -50% 0;
    width: calc(var(--size) * 193 / 180);
    z-index: calc(var(--count) - var(--d));
  }

  .standard a:where(:hover, :focus) .graphic {
    --band: 8;
  }

  .standard a:where(:hover, :focus) .disc {
    animation-play-state: running;
    top: var(--top);
  }

  .standard .cover {
    aspect-ratio: 1;
    background: var(--machine-color);
    border: 1px solid currentColor;
    position: relative;
    z-index: 4;
  }

  .standard .cover img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .standard .info {
    padding-left: 0;
    padding-right: 0;
  }

  ul.mini {
    container-name: mini-ul;
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    row-gap: calc(var(--sp-8) * 2);
  }

  .mini li {
    flex: 1 1 var(--target-width, 100%);
    max-width: var(--target-width, 100%);
    padding: 0 var(--g-gutter) calc(var(--sp-10) * 4);
  }

  @container mini-ul (min-width: 700px) {
    .mini li {
      --target-width: 50%;
    }
  }

  @container mini-ul (min-width: 1060px) {
    .mini li {
      --target-width: 33%;
    }
  }

  @container mini-ul (min-width: 1320px) {
    .mini li {
      --target-width: 25%;
    }
  }

  .mini a {
    align-items: flex-start;
    display: flex;
    column-gap: 0.5rem;
  }

  .mini .graphic {
    border-right: 2px solid var(--color-text);
    flex: 0 0 55px;
    padding-top: 95px;
    rotate: var(--rotation);
  }

  .mini .vinyl {
    left: 0;
    position: absolute;
    top: 0;
    transform-origin: 50.5% 50.6%;
    width: 100px;
  }

  .mini a:where(:hover, :focus) .vinyl {
    animation: spin 1s linear infinite;
  }

  .mini .info {
    flex: 1 1 70%;
    margin-top: 0;
  }

  .mini .desciption {
    margin-top: var(--sp-10);
  }
</style>
