---
import type { Release } from "@types";
import store, { getUniqueReleases } from "@store";
import Layout from "@layouts/Layout.astro";
import Releases from "@components/Releases.astro";

/*
  We want to display releases in the correct order, so we need to build a new
  array from the releasesByArtist object. Releases with multiple artists only
  appear once.
*/
const releasesDisplay: Release[] = getUniqueReleases(store.releasesByArtist);
const artists = store.artists;
---

<Layout title="Wax">
  <main class="standard-restricted-width">
    <h1 class="standard-page-title">
      Since 2002, <a href="https://tylergaw.com">I’ve</a> collected
      {releasesDisplay.length} records from {artists.length}
      <a href="/artists">artists</a>.
    </h1>
    <Releases releases={releasesDisplay} />
  </main>
</Layout>
