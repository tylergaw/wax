---
export interface props {
  artist: string;
  release: Release;
}

import type { Release } from "@types";
import Vinyl from "@components/Vinyl.astro";
import {
  buildUrl,
  getCoverUrl,
  getHumanColor,
  getMachineColor,
  getArtistDisplayName,
  getDiscCount,
  getFormatLabel,
} from "@util/data";
import { getReleaseDateParts } from "@util/log";

const { artist, release } = Astro.props;
const { title } = release.basic_information;
const coverUrl = getCoverUrl(release, 1200);
const format = getFormatLabel(release);
const discs = Math.min(getDiscCount(release), 6);
const dateParts = getReleaseDateParts(release);
---

<div class="container" style={`--machine-color: ${getMachineColor(release)}`}>
  <header>
    <h1 class="title">{title}</h1>
    <p class="subtitle">
      <a href={buildUrl([artist])}>{getArtistDisplayName(artist)}</a> /{" "}
      {format && `${format} / `}
      {getHumanColor(release)}
    </p>
    {
      dateParts.length > 0 && (
        <p class="dates">
          {dateParts.map((part, i) => (
            <>
              {i > 0 && ", "}
              {part.href ? <a href={part.href}>{part.text}</a> : part.text}
            </>
          ))}
        </p>
      )
    }
  </header>
  <div class="graphic">
    <div class="unit" style={`--discs: ${discs}`}>
      {
        Array.from({ length: discs }, (_, i) => discs - 1 - i).map((i) => (
          <div
            class:list={["disc", i < discs - 1 && "in-front"]}
            style={`--i: ${i}`}
          >
            <Vinyl class="vinyl" color={getMachineColor(release)} />
          </div>
        ))
      }
      <div class="cover">
        {coverUrl && <img src={coverUrl} alt="" width="600" height="600" />}
      </div>
    </div>
  </div>
</div>

<style>
  header {
    padding-bottom: calc(var(--sp-8) * 4);
    padding-top: calc(var(--sp-8) * 2);
    text-align: center;
  }

  .title {
    font-style: italic;
    font-size: 72px;
    font-weight: 900;
    line-height: 1;
    margin: 0;
  }

  .subtitle {
    color: var(--color-accent-primary);
    font-size: var(--font-size-22);
    font-weight: 300;
    margin: 0 auto;
    max-width: 800px;
    padding-top: var(--sp-14);
  }

  .dates {
    font-size: var(--font-size-16);
    font-weight: 300;
    margin: 0;
    padding-top: var(--sp-4);
  }

  :is(.subtitle, .dates) a {
    color: inherit;
  }

  .dates a:where(:hover, :focus) {
    color: var(--color-accent-primary);
  }

  .graphic {
    container-type: inline-size;
    display: flex;
    justify-content: center;
    padding-bottom: var(--sp-20);
  }

  .unit {
    --step: 0.12;
    --width: calc(1.45 + var(--step) * (var(--discs) - 1));
    --cover: min(100cqw / var(--width), 600px);
    height: var(--cover);
    position: relative;
    width: calc(var(--cover) * var(--width));
  }

  .cover {
    aspect-ratio: 1;
    background: var(--machine-color);
    border: 1px solid currentColor;
    left: 0;
    position: absolute;
    top: 0;
    width: var(--cover);
  }

  img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .disc {
    --room: calc(var(--cover) * 0.02);
    left: calc(var(--cover) * (0.44 + var(--step) * var(--i)));
    overflow: hidden;
    padding: var(--room) 0;
    position: absolute;
    top: calc(var(--cover) * 0.015 - var(--room));
    width: calc(var(--cover) * 1.04);
  }

  .in-front {
    filter: drop-shadow(1.5px 0 0 rgb(255 255 255 / 0.7));
  }

  .vinyl {
    animation: spin 1.5s linear infinite;
    animation-delay: calc(var(--i) * -0.37s);
    display: block;
    pointer-events: none;
  }
</style>
